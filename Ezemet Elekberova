//istifadeciden 1 eded alin , 1-den hemin edede qeder olan butun cut ededlerin kvadratlari cemini tapin.
void kvadrat() {
	int a, k, s = 0;
	cout << "eded daxil et" << endl;
	cin >> a;

	for (int i = 1; i <= a; i++)
	{

		if (i % 2 == 0) {
			k = i * i;
			s = s + k;
		}
		
	}
	cout << s;
}

