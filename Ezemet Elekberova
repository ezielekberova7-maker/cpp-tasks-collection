//sade olub olmamasini yoxlayan kod
void sade() {
	int n;
	cout << "eded daxil edin" << endl;
	cin >> n;
	if (n < 2) {
		cout << n << " sade eded deyil" << endl;
	}
	else {
		int i;
		for (i = 2;i * i <= n;i++) {
			if (n % i == 0) {
				break;
			}

		}
		if (i * i > n) {
			cout << n << " sade ededdir" << endl;
		}
		else {
			cout << n << " sade eded deyil" << endl;
		}
	}
}



//fibonacci ededler arasinda 1000 den kicik olanlari cap edin.
void fibonacci() {
	int a = 0, b = 1;
		while (a < 1000) {
			cout << a << " ";
			b = b + a;
			a = b - a;
		}
	cout << endl;
}




